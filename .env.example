# Copy to .env (scripts/install.sh does this for you) and edit.
# One KEY=value per line. Comments go on their own lines.

# FastAPI backend (serves /api and the dashboard)
APP_HOST=0.0.0.0
APP_PORT=8000

# AI_MODE: mock | ollama
AI_MODE=mock
# MOCK_AI_SCENARIO: A = correct first try, B = wrong then fixed with feedback
MOCK_AI_SCENARIO=A
# UTM shared-network gateway = the Mac; confirm with `ip route` in the VM
OLLAMA_URL=http://192.168.64.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120

# LAB_MODE: real = network namespaces + nftables (Linux, root) | fake = in-memory lab
LAB_MODE=real

# Lab topology. Every subnet is a /24; the router takes .1 on each.
NS_EMPLOYEE=employee
NS_APP=app
NS_DB=db
NS_ROUTER=router
EMPLOYEE_IP=10.10.10.10
EMPLOYEE_NET=10.10.10.0/24
APP_IP=10.10.20.10
APP_SERVICE_PORT=8080
DB_IP=10.10.30.10
DB_PORT=5432

# Lab database (the company app connects to DB_IP:DB_PORT with these)
DB_NAME=company
DB_USER=app_user
DB_PASSWORD=change-me

# Where the lab keeps PostgreSQL data, sockets, pidfiles and logs (outside the repo)
LAB_STATE_DIR=/var/lib/cybersec-lab

POLL_INTERVAL_SECONDS=2
MAX_ATTEMPTS=3
LOG_LEVEL=INFO
